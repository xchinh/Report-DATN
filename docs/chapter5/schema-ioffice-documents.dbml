// DBML phục vụ ERD Chương 5, không dùng để sinh DDL.
// Quan hệ đa hình và liên kết sang nhiệm vụ được ghi chú, không khai báo thành FK vật lý.

Project chapter5_ioffice_documents {
  database_type: 'PostgreSQL'
  Note: 'Nhóm dữ liệu văn bản thuộc CSDL iOffice hiện hữu.'
}

TableGroup ioffice_documents [color: #7C3AED] {
  eoffice_van_ban_den
  eoffice_van_ban_di
  eoffice_distribution
}

Table eoffice_van_ban_den {
  id integer [pk, increment, not null]
  so_van_ban varchar(255)
  noi_dung text
  khan boolean
  don_vi_gui integer
  ten_don_vi_gui varchar(255)
  ngay_van_ban bigint
  ngay_nhan bigint
  loai_van_ban integer
  han_hoan_thanh bigint
  trang_thai varchar(20)
  step_no integer
  is_deleted boolean
  quy_so_id integer
  quy_trinh_config_id integer
  mission_id integer [note: 'Liên kết logic đến mission_general.id.']
  created_at bigint [not null]
}

Table eoffice_van_ban_di {
  id integer [pk, increment, not null]
  ky_hieu varchar(50)
  so varchar(50)
  ma_don_vi varchar(10)
  trich_yeu varchar(2000)
  nam integer
  loai_van_ban integer
  trang_thai varchar(50)
  cap_van_ban varchar(10)
  quy_so_id integer
  step_no integer
  quy_trinh_id integer
  ngay_van_ban varchar(2)
  thang_van_ban varchar(2)
  nam_van_ban varchar(4)
  created_at bigint
  updated_at bigint
  deleted_at bigint
  created_by varchar(20)
}

Table eoffice_distribution {
  id integer [pk, increment, not null]
  distributed_id integer
  distributed_type varchar(20)
  shcc varchar(10)
  ma_don_vi varchar(10)
  distributed_at bigint
  distributed_by varchar(10)
  note text
  is_active boolean
  status varchar(20)
  viewed_at bigint
  ly_do_tu_choi text
  Note: 'distributed_id tham chiếu logic đến loại đối tượng do distributed_type xác định; không thể biểu diễn bằng một FK đơn.'
}
